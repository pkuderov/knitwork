{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "env": {
    "GIT_AUTHOR_NAME": "Vladimir",
    "GIT_AUTHOR_EMAIL": "aberay89@bk.ru",
    "GIT_COMMITTER_NAME": "Ваше Имя",
    "GIT_COMMITTER_EMAIL": "aberay89@bk.ru",
    "ANTHROPIC_DISABLE_TELEMETRY": "1"
  },

  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "mcp__context7__resolve-library-id",
      "Bash(python*)",
      "Bash(pip*)",
      "Bash(uv*)",
      "Bash(uvx*)",
      "Bash(conda*)",
      "Bash(jupyter*)",
      "Bash(pytest*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(wc*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(sudo rm*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },

  "autoMemoryEnabled": true,
  "preferredLanguage": "russian",
  "transcriptRetentionDays": 90,

  "attribution": {
    "commit": "",
    "pr": ""
  }
}